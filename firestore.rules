rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    // Auth tokens never contain roles directly in AI Studio standard setups,
    // so we lookup in the users collection with a fallback for bootstrap admins.
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.uid == '7sLIw5ysmHU685q16IzryGqZQBk2' || 
        request.auth.uid == '7uwbqs3lla3jf4ghux6e6b' || 
        request.auth.token.email == 'mozelentreprise@gmail.com' || 
        request.auth.token.email == 'fenrirunix@gmail.com' ||
        request.auth.token.email == 'contact@mozel.com'
      );
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isAdmin() || isOwner(userId));
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isOwner(userId) && isValidUser(incoming());
      allow update: if isValidId(userId) && (isAdmin() || (
        isOwner(userId) && isValidUser(incoming()) && (
          // Action: Update Favorites
          incoming().diff(existing()).affectedKeys().hasOnly(['favorites']) ||
          // Action: Update Profile (Non-privilege fields)
          (incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL']) &&
           incoming().isPremium == existing().isPremium &&
           incoming().isAdmin == existing().isAdmin)
        )
      ));
      allow delete: if isValidId(userId) && isAdmin();
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'photoURL', 'isPremium', 'isAdmin', 'favorites']) &&
             data.uid is string &&
             data.email is string && data.email.size() <= 200 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.photoURL is string && data.photoURL.size() <= 1000 &&
             data.isPremium is bool &&
             data.isAdmin is bool &&
             data.favorites is list && data.favorites.size() <= 1000;
    }

    function isValidWallpaper(data) {
      return data.get('title', '') is string &&
             data.get('imageUrl', '') is string &&
             data.get('views', 0) is number &&
             data.get('downloads', 0) is number &&
             data.get('likes', 0) is number;
    }

    // Wallpapers
    match /wallpapers/{wallpaperId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAdmin();
      allow update: if (isAdmin() || (
        // Action: Increment Stats
        isValidWallpaper(incoming()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['views', 'downloads', 'likes', 'updatedAt']) &&
        incoming().updatedAt == request.time &&
        // Ensure immutable fields stay immutable
        (!('title' in existing()) || incoming().title == existing().title) &&
        (!('imageUrl' in existing()) || incoming().imageUrl == existing().imageUrl) &&
        (!('authorId' in existing()) || incoming().authorId == existing().authorId)
      ));
      allow delete: if isAdmin();
    }

    // Categories
    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow write: if isAdmin() && isValidId(categoryId);
    }

    // Settings
    match /settings/{settingId} {
      allow get: if isAdmin() && isValidId(settingId);
      allow list: if isAdmin();
      allow write: if isAdmin() && isValidId(settingId);
    }

    // Support Chats
    match /support_chats/{userId}/messages/{messageId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Contact Messages
    match /contact_messages/{messageId} {
      allow create: if isValidId(messageId); // Public can send messages
      allow get: if isAdmin() && isValidId(messageId);
      allow list: if isAdmin();
      allow update, delete: if isAdmin() && isValidId(messageId);
    }

    // Newsletter
    match /newsletter/{subId} {
      allow create: if isValidId(subId); // Public can subscribe
      allow get: if isAdmin() && isValidId(subId);
      allow list: if isAdmin();
      allow update, delete: if isAdmin() && isValidId(subId);
    }
  }
}
